{
  "name": "villow-setup",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build",
    "test": "vitest run",
    "test:build-profiles": "node scripts/check-ui-builds.mjs",
    "test:packaging": "node --test tests/desktop-profile.test.mjs",
    "native:test": "node scripts/native.mjs test --locked --no-default-features",
    "native:check": "node scripts/native.mjs check --locked",
    "desktop:dev": "node scripts/tauri.mjs dev",
    "desktop:dev:testing": "node scripts/tauri.mjs dev --testing-tools",
    "desktop:build": "node scripts/tauri.mjs build --bundles nsis",
    "desktop:build:alpha": "node scripts/tauri.mjs build --bundles nsis --unsigned-alpha",
    "desktop:build:testing": "node scripts/tauri.mjs build --bundles nsis --testing-tools",
    "security:scan": "node scripts/security-scan.mjs",
    "license:inventory": "node scripts/license-inventory.mjs",
    "release:gate": "node scripts/release-gate.mjs",
    "portability": "node scripts/portability.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vitest": "4.1.11"
  }
}
